# ── Database ─────────────────────────────────────────────────
# Local docker-compose:
POSTGRES_DB=eduplatform
POSTGRES_USER=eduuser
POSTGRES_PASSWORD=supersecretpassword
# Free hosting (e.g. Hugging Face Spaces backend, see DEPLOY.md): set
# DATABASE_URL directly to a free managed Postgres, e.g. Neon
# (https://neon.tech) — copy its "postgresql://..." connection string and
# change the prefix to "postgresql+asyncpg://" for this app's async driver.
DATABASE_URL=postgresql+asyncpg://eduuser:supersecretpassword@localhost:5432/eduplatform

# ── Vector store (Qdrant) ────────────────────────────────────
# Local docker-compose uses QDRANT_HOST/QDRANT_PORT below.
# For free hosting, create a free cluster at https://cloud.qdrant.io and set:
QDRANT_URL=
QDRANT_API_KEY=

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-32-random-chars

# ── AI / OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o
# Options: gpt-4o | claude-3-5-sonnet-20241022 | gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-3-large

# ── Payment ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these in your Stripe dashboard → Products → Prices
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
PAYMOB_API_KEY=

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=production
# Frontend origin(s), no trailing slash. Comma-separate for multiple.
CORS_ORIGINS=https://your-app.vercel.app
# Backend origin, no trailing slash and no /api suffix — the frontend calls
# routes like /auth/login directly against this base URL.
NEXT_PUBLIC_API_URL=https://your-space.hf.space
